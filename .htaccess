<IfModule mod_rewrite.c>
    RewriteEngine On
    # Sin RewriteBase fijo: en MAMP el sitio vive en /sidvvi y en producción en la raíz del dominio.

    # --- Solo en producción: descomenta para forzar HTTPS y quitar www ---
    # RewriteCond %{HTTPS} off [OR]
    # RewriteCond %{HTTP_HOST} ^www\.sidvvi\.com$ [NC]
    # RewriteRule ^(.*)$ https://sidvvi.com/$1 [L,R=301]

    # Bloquear acceso directo a carpetas internas
    RewriteRule ^(application|vendor|database|docs|prompts|\.cursor)(/.*)?$ - [F,L]
    RewriteRule ^\.env - [F,L]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "service-worker\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
