# ===== SIDVVI · Variables de entorno =====
# Copia este archivo como .env y ajusta los valores.

# development | production
APP_ENV=development
APP_TIMEZONE=America/Mexico_City

# Local MAMP: http://localhost:8888/sidvvi/
# Producción: https://sidvvi.com/
BASE_URL=http://localhost:8888/sidvvi/

# Clave de cifrado (32 caracteres aleatorios)
ENCRYPTION_KEY=cambia_esta_clave_por_32_caracteres

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=sidvvi
DB_USER=root
DB_PASS=root

# Correo SMTP (formulario de contacto y membresía)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_CRYPTO=tls
MAIL_FROM=no-reply@sidvvi.com
MAIL_FROM_NAME=SIDVVI

# URL del subsistema de Congresos (registro y constancias)
CONGRESS_APP_URL=https://sidvvi.com/congresos-app/

# reCAPTCHA v3. Si se dejan vacías, contacto y membresía usan honeypot y límite por IP.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Web Push. La pública se manda al navegador; la privada no sale del servidor.
VAPID_PUBLIC=
VAPID_PRIVATE=

# Instagram (App ID, App Secret y token) NO va aquí.
# Se guarda cifrado en la base y solo lo edita el superadministrador:
# Panel → Conexión Instagram.
